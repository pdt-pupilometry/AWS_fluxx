# Copia este archivo a .env y completa tus valores reales.
# NUNCA subas el .env real a git (ya está en .gitignore).

# --- Credenciales de AWS ---------------------------------------------------
# Usuario/rol IAM con permisos para desplegar: CloudFormation, Lambda, S3,
# ECR, Step Functions, IAM (crear roles), EventBridge.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo si usas credenciales temporales (SSO, assume-role, etc.)
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# --- Endpoint externo -------------------------------------------------------
# Recibe una notificacion pequena con metadata + un link de descarga (S3
# presigned URL) al archivo JSON/CSV consolidado -- no la data inline.
ENDPOINT_URL=https://api.tu-servidor.com/resultados
ENDPOINT_API_KEY=

# --- Parametros del pipeline (opcionales, ver template.yaml para el resto) -
STACK_NAME=ocular-pipeline
MAX_CONCURRENCY=1000
# Tope de ejecuciones simultaneas del notifier (protege el endpoint externo).
# Con cuota Lambda = 10 no se puede reservar nada: usa 0 (omite la reserva).
# Con cuota >= 1000, 5 es el default sensato.
NOTIFIER_RESERVED_CONCURRENCY=5
# Frames por invocacion de la Lambda de inferencia. 8 es el sweet spot medido
# (ver tabla de mediciones en el README): amortiza el overhead por invocacion
# sin acercarse al timeout de 60s ni concentrar demasiados frames por fallo.
MAX_ITEMS_PER_BATCH=8
OUTPUT_FORMAT=json
GZIP_FILE=true
PRESIGNED_URL_EXPIRATION_SECONDS=3600
# Memoria (MB) de las Lambdas de extraccion e inferencia. En Lambda, la CPU
# escala con la memoria (~1 vCPU por cada 1769 MB): mas memoria = decode e
# inferencia mas rapidos. 5307 MB = 3 vCPU, el sweet spot medido para este
# modelo (escala hasta 3 hilos; con mas vCPU no mejora por contencion).
# OJO: cuentas nuevas tienen un cap real de 3008 MB aunque Service Quotas
# muestre mas ("Max allocated memory"). El deploy falla con "MemorySize ...
# less than or equal to 3008" hasta que se apruebe un aumento (request via
# Service Quotas, codigo L-CD1C0CC4). Mientras tanto usar 3008.
EXTRACTOR_MEMORY=3008
INFERENCE_MEMORY=3008
